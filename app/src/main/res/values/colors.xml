<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paleta ASC Cine: cinema premium, vinho e dourado. Regra de uso: 70% fundo, 20% cards/menus, 10% destaque. -->
    <color name="asc_bg">#2A0615</color>
    <color name="asc_white">#FFFFFF</color>
    <!-- Destaque (botões, item selecionado, barra de progresso). Única fonte da cor de destaque. -->
    <color name="asc_accent">#8C1D40</color>
    <!-- Texto/ícone sobre elementos de destaque (sempre branco). -->
    <color name="asc_on_accent">#FFFFFF</color>
    <!-- Brilho suave (foco, textos de destaque) e dourado (só detalhes pequenos). -->
    <color name="asc_glow">#C4486F</color>
    <color name="asc_gold">#E3C27A</color>
    <!-- Variações do destaque (só para ilustrações como os avatares). -->
    <color name="asc_accent_light">#E8A3B8</color>
    <color name="asc_accent_dark">#5A1228</color>
    <!-- Cards e menus -->
    <color name="asc_surface">#43101F</color>
    <color name="asc_surface_focus">#52192B</color>
    <color name="asc_text2">#D9C9CF</color>
    <color name="asc_text3">#9C8790</color>
    <!-- Borda sutil: branco com 8% de opacidade -->
    <color name="asc_line">#14FFFFFF</color>
    <color name="asc_error">#E5736F</color>
    <!-- Ícone do app -->
    <color name="ic_launcher_background">#2A0615</color>
</resources>
