<?xml version="1.0" encoding="utf-8"?>
<!-- Botões dos teclados (senha e busca): escuro, e no foco ganha contorno violeta. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_surface_focus" />
            <stroke android:width="3dp" android:color="@color/asc_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_surface_focus" />
            <stroke android:width="3dp" android:color="@color/asc_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_surface_focus" />
            <stroke android:width="3dp" android:color="@color/asc_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_surface" />
            <stroke android:width="1dp" android:color="@color/asc_line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
